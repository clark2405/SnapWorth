{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "customConditions": ["react-native-legacy-deep-imports"],
    "types": ["react", "react-native"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.property.test.ts",
    "src/**/*.property.test.tsx"
  ]
}
