    "@snapworth/shared": "0.0.0",
    "@supabase/supabase-js": "2.117.2",
    "expo": "57.0.26",
    "expo-blur": "57.0.3",
    "expo-constants": "57.0.20",
    "expo-font": "57.0.4",
    "expo-glass-effect": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "lucide-react-native": "1.47.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
