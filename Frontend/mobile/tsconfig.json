{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "customConditions": ["react-native"],
    "moduleResolution": "Bundler",
    "types": ["react", "react-native"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "*.ts",
    "../shared/src/**/*.d.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
