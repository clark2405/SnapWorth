# Copy to .env.local and fill in to use a Supabase project (see Backend/README.md).
# Leave empty to keep comments on this device instead.
#
# Project Settings → API in the Supabase dashboard. Use the public anon key only: these values
# are bundled into the app. Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The meetup map's street tiles: any {z}/{x}/{y} raster tile URL, and the credit its provider
# requires. Leave empty for CARTO's Voyager basemap (free with limits; commercial use needs a
# CARTO license), or set the URL to `none` to turn the map off.
EXPO_PUBLIC_MAP_TILES_URL=
EXPO_PUBLIC_MAP_TILES_ATTRIBUTION=
