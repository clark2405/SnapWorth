{
  "name": "@snapworth/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "SnapWorth Expo Router app for iOS and Android",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:go": "expo start --go",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "build": "expo export --platform ios --output-dir dist/ios && expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo-google-fonts/dm-mono": "0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@snapworth/shared": "0.0.0",
    "@supabase/supabase-js": "2.117.2",
    "expo": "58.0.19",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "1.47.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "3.0.0",
    "react-native-worklets": "0.13.0"
  }
}
