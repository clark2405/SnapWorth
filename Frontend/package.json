{
  "name": "snapworth-frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "web",
    "mobile",
    "shared"
  ],
  "scripts": {
    "build:web": "npm run build --workspace=@snapworth/web",
    "dev": "npm run dev --workspace=@snapworth/web",
    "check:architecture": "eslint ./web/app ./shared/src --max-warnings=0 && node ./scripts/validate-source.mjs architecture",
    "check:dependency-pins": "node ./scripts/validate-workspace.mjs dependencies",
    "check:static": "node ./scripts/validate-source.mjs all",
    "check:topology": "node ./scripts/validate-workspace.mjs topology",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --config ./jest.config.cjs --runInBand --passWithNoTests",
    "test:browser": "playwright test --config ./playwright.config.ts --pass-with-no-tests",
    "test:property": "jest --config ./jest.property.config.cjs --runInBand --passWithNoTests",
    "test:unit": "jest --config ./jest.unit.config.cjs --runInBand --passWithNoTests",
    "typecheck": "tsc --project ./shared/tsconfig.json --noEmit && tsc --project ./web/tsconfig.json --noEmit && tsc --project ./mobile/tsconfig.json --noEmit",
    "validate": "npm run check:topology && npm run check:dependency-pins && npm run check:static && npm run typecheck && npm run lint && npm run test:unit && npm run test:property",
    "dev:mobile": "npm run dev --workspace=@snapworth/mobile",
    "ios": "npm run ios --workspace=@snapworth/mobile",
    "android": "npm run android --workspace=@snapworth/mobile"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@expo/metro-config": "57.0.12",
    "@playwright/test": "1.63.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.3",
    "@types/react": "19.2.14",
    "babel-jest": "30.2.0",
    "babel-preset-expo": "57.0.12",
    "eslint": "10.10.0",
    "fast-check": "4.10.1",
    "globals": "17.12.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-environment-node": "30.2.0",
    "jest-expo": "57.0.5",
    "prettier": "3.9.7",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
